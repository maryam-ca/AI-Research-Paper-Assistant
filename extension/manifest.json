{
  "manifest_version": 3,
  "name": "ScholarFlow Quick Add",
  "version": "1.0.0",
  "description": "Add the current page or a document link to your ScholarFlow library.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScholarFlow Quick Add"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
